[
  {
    "id": "qac-memory",
    "status": "active",
    "deliverable": "cards",
    "title": "教材驱动·概念关系出题",
    "appliesTo": {
      "cardTypes": ["名词解释", "机制类主观题", "要点型问答"],
      "subjects": ["医学", "生物", "法律", "任意有明确章节结构的教材"],
      "materials": ["教材", "讲义"]
    },
    "inputs": [
      { "kind": "textbook", "required": true, "note": "有目录层级与小节标题" }
    ],
    "methods": [
      { "stage": "collect", "how": "先看目录与本节小节标题，把内容归成几组关系；不先逐段读正文", "produces": "关系分组" },
      { "stage": "organize", "how": "一组关系出一道题；不把一个关系切成碎片", "produces": "按关系分组的问题" },
      { "stage": "solve", "how": "回到对应小节取原文，按原文编号写成树", "produces": "带依据的答案" },
      { "stage": "make", "how": "按模板填字段；形式按内容结构选序号树或表格", "produces": "卡" }
    ],
    "output": {
      "model": "QAC 问答挖空 v4（国标引用）",
      "template": "qac-v4",
      "fields": [
        { "name": "问题", "role": "content", "spec": "单独可读、只问一条线索、以「？」结尾", "required": true },
        { "name": "章节定位", "role": "locator", "spec": "书名 ‖ 章 ‖ 节，与目录层级一致", "required": true },
        { "name": "要点数", "role": "meta", "spec": "答案去标签后的可见字数，写 N字", "required": true },
        { "name": "答案", "role": "content", "spec": "整段 {{c1:: … }}；序号 <b>1.</b> 段首", "required": true },
        { "name": "笔记", "role": "memory", "spec": "记忆提示：怎么背，不复述答案", "required": false },
        { "name": "引用", "role": "locator", "spec": "书目 + ‖ p页:L起-止", "required": false }
      ]
    },
    "presentation": {
      "forms": ["outline", "table"],
      "chooseBy": "并列或分层用序号树；同一维度上的行列对照用表格"
    },
    "quality": {
      "rules": [
        { "id": "q-ask", "field": "问题", "kind": "endsWith", "value": "？" },
        { "id": "a-open", "field": "答案", "kind": "startsWith", "value": "{{c1::" },
        { "id": "a-close", "field": "答案", "kind": "endsWith", "value": "}}" },
        { "id": "a-length", "field": "答案", "kind": "maxLength", "value": 220 },
        { "id": "a-no-markdown", "field": "答案", "kind": "forbids", "value": "\\*\\*" },
        { "id": "meta-length", "field": "要点数", "kind": "lengthOf", "sourceField": "答案" }
      ],
      "rubric": "分支名来自原文标题；问题与答案问的是同一件事；定位能回查"
    },
    "acceptance": { "criteria": "先做 2–3 张样卡确认写法与尺度" },
    "limits": ["依赖目标模型已存在；含上下标的 PDF 行定位需人工核对"],
    "origin": { "kind": "seed", "note": "教材驱动示例" }
  },
  {
    "id": "qac-exam",
    "status": "active",
    "deliverable": "cards",
    "title": "题源驱动·逐题取证",
    "appliesTo": {
      "cardTypes": ["真题解析", "题库点"],
      "subjects": ["医学", "法学", "资格考试", "任意有题库的科目"],
      "materials": ["真题", "题库", "习题集"]
    },
    "inputs": [
      { "kind": "question", "required": true, "note": "原题，含选项与题源" },
      { "kind": "textbook", "required": true, "note": "用于逐题找依据" }
    ],
    "methods": [
      { "stage": "organize", "how": "先把题目原样列出，保留选项、题号、题源；题干不改写", "produces": "题目清单" },
      { "stage": "collect", "how": "逐题按题干里的小节标题词定位，不按概念词；取到能回答这道题的行", "produces": "每题依据" },
      { "stage": "solve", "how": "只回答这道题问的事；选项题保留正确选项的原文表述", "produces": "逐题答案" },
      { "stage": "make", "how": "按模板填字段；题源写进引用", "produces": "卡" }
    ],
    "output": {
      "model": "QAC 问答挖空 v4（国标引用）",
      "template": "qac-v4",
      "fields": [
        { "name": "问题", "role": "content", "spec": "照抄题干（可精简为问句），保留题号信息在引用里", "required": true },
        { "name": "章节定位", "role": "locator", "spec": "依据所在章节", "required": true },
        { "name": "要点数", "role": "meta", "spec": "答案去标签后的可见字数，写 N字", "required": true },
        { "name": "答案", "role": "content", "spec": "只答这道题；整段 {{c1:: … }}", "required": true },
        { "name": "笔记", "role": "memory", "spec": "这道题最易错的一点", "required": false },
        { "name": "引用", "role": "locator", "spec": "题源（题号/出处）+ 书目 + ‖ p页:L起-止", "required": true }
      ]
    },
    "presentation": { "forms": ["outline", "table"], "chooseBy": "按选项/对比关系决定：选项并列用表格，单点用序号树" },
    "quality": {
      "rules": [
        { "id": "q-ask", "field": "问题", "kind": "endsWith", "value": "？" },
        { "id": "a-open", "field": "答案", "kind": "startsWith", "value": "{{c1::" },
        { "id": "a-close", "field": "答案", "kind": "endsWith", "value": "}}" },
        { "id": "meta-length", "field": "要点数", "kind": "lengthOf", "sourceField": "答案" },
        { "id": "cite-required", "field": "引用", "kind": "required" },
        { "id": "cite-locator", "field": "引用", "kind": "matches", "value": "‖\\s*p\\d+:" }
      ],
      "rubric": "题面与原文问的是同一件事；选项与题源完整；依据能回查"
    },
    "acceptance": { "criteria": "先跑一道题，确认题源与依据对得上" },
    "limits": ["题干本身有争议时须停下问用户"],
    "origin": { "kind": "seed", "note": "题源驱动示例" }
  },
  {
    "id": "question-set",
    "status": "active",
    "deliverable": "question-set",
    "title": "只交问题集（不出卡）",
    "appliesTo": {
      "cardTypes": ["复习清单", "题库初稿"],
      "subjects": ["任意"],
      "materials": ["讲义", "题库", "大纲"]
    },
    "inputs": [{ "kind": "material", "required": true, "note": "要覆盖的范围" }],
    "methods": [
      { "stage": "organize", "how": "按覆盖范围逐条出题，记录 id、题干、题型、来源", "produces": "问题集" }
    ],
    "output": { "model": "", "fields": [] },
    "presentation": { "forms": ["table", "list"], "chooseBy": "默认表格；用户要列表就列表" },
    "quality": {
      "rules": [],
      "rubric": "每题有稳定 id 与可回查来源；有原题照抄；自拟题标明；复合问题拆开"
    },
    "acceptance": { "criteria": "抽三条核对来源可回查" },
    "limits": ["不写入 Anki，也不需要笔记模型"],
    "origin": { "kind": "seed", "note": "不出卡示例" }
  }
]
