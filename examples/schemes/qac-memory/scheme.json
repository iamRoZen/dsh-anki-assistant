{
  "id": "qac-memory",
  "status": "active",
  "deliverable": "cards",
  "title": "教材驱动·概念关系出题（QAC 六字段）",
  "appliesTo": {
    "cardTypes": [
      "名词解释",
      "机制类主观题",
      "要点型问答"
    ],
    "subjects": [
      "医学",
      "生物",
      "法律",
      "任意有明确章节结构的教材"
    ],
    "materials": [
      "教材",
      "讲义"
    ]
  },
  "inputs": [
    {
      "kind": "textbook",
      "required": true,
      "note": "有目录层级与小节标题"
    }
  ],
  "methods": [
    {
      "stage": "collect",
      "how": "先看目录与本节小节标题，把内容归成几组关系；不先逐段读正文",
      "produces": "关系分组 + 每组对应的页行"
    },
    {
      "stage": "organize",
      "how": "一组关系出一道题；不把一个关系切成碎片",
      "produces": "按关系分组的题"
    },
    {
      "stage": "solve",
      "how": "回到对应小节取原文，按原文编号写成树",
      "produces": "带依据的答案"
    },
    {
      "stage": "make",
      "how": "按模板填字段；形式按内容结构选序号树或表格",
      "produces": "卡"
    }
  ],
  "output": {
    "model": "QAC 问答挖空 v4（国标引用）",
    "template": "qac-v4",
    "fields": [
      {
        "name": "问题",
        "role": "content",
        "spec": "以「？」结尾；不含选项字母；不出现答案里的关键词（出现即泄题）",
        "required": true
      },
      {
        "name": "章节定位",
        "role": "locator",
        "spec": "`书名 ‖ 章 ‖ 节`，分隔符是全角 ‖；节名照目录原文",
        "required": true
      },
      {
        "name": "要点数",
        "role": "meta",
        "spec": "答案去标签与挖空标记后的可见字数，写 `N字`",
        "required": true
      },
      {
        "name": "答案",
        "role": "content",
        "spec": "整段 `{{c1:: … }}`；序号 `<b>1.</b>` / `<b>1.1</b>` 放段首；单行 ≤25 字；不用 <ul>/<ol>；不用 Markdown",
        "required": true
      },
      {
        "name": "笔记",
        "role": "memory",
        "spec": "两行以内；写回忆起点与最易漏的一步；不得复述答案首句",
        "required": false
      },
      {
        "name": "引用",
        "role": "locator",
        "spec": "书目〔版本〕+ `‖ p页:L起-止`；行号口径：页眉算第 1 行",
        "required": true
      }
    ]
  },
  "presentation": {
    "forms": [
      "outline",
      "table"
    ],
    "chooseBy": "并列或分层用序号树；同一维度上的行列对照用表格"
  },
  "quality": {
    "rules": [
      {
        "id": "q-ask",
        "field": "问题",
        "kind": "endsWith",
        "value": "？"
      },
      {
        "id": "q-no-option",
        "field": "问题",
        "kind": "forbids",
        "value": "[ABCD][．.、]"
      },
      {
        "id": "a-open",
        "field": "答案",
        "kind": "startsWith",
        "value": "{{c1::"
      },
      {
        "id": "a-close",
        "field": "答案",
        "kind": "endsWith",
        "value": "}}"
      },
      {
        "id": "a-no-list",
        "field": "答案",
        "kind": "forbids",
        "value": "<ul|<ol|\\*\\*"
      },
      {
        "id": "a-length",
        "field": "答案",
        "kind": "maxLength",
        "value": 220
      },
      {
        "id": "meta-length",
        "field": "要点数",
        "kind": "lengthOf",
        "sourceField": "答案"
      },
      {
        "id": "loc-form",
        "field": "章节定位",
        "kind": "matches",
        "value": "‖"
      },
      {
        "id": "cite-locator",
        "field": "引用",
        "kind": "matches",
        "value": "‖\\s*p\\d+:L?\\d+"
      }
    ],
    "rubric": "分支名必须是原文标题里的词；问题与答案问的是同一件事；压缩不删层级/限定语/方向；表格只用于同维度对照"
  },
  "acceptance": {
    "criteria": "先做 2–3 张样卡确认写法与尺度；样卡不过不批量"
  },
  "limits": [
    "依赖目标模型已存在",
    "PDF 上下标会被拆行，含 α₁ 之类的内容需人工核对行号"
  ],
  "origin": {
    "kind": "seed",
    "note": "教材驱动示例"
  }
}
