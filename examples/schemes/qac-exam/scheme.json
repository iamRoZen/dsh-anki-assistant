{
  "id": "qac-exam",
  "status": "active",
  "deliverable": "cards",
  "title": "题源驱动·逐题取证（QAC 六字段）",
  "appliesTo": {
    "cardTypes": [
      "真题解析",
      "题库点"
    ],
    "subjects": [
      "医学",
      "法学",
      "资格考试",
      "任意有题库的科目"
    ],
    "materials": [
      "真题",
      "题库",
      "习题集"
    ]
  },
  "inputs": [
    {
      "kind": "question",
      "required": true,
      "note": "原题，含选项与题源"
    },
    {
      "kind": "textbook",
      "required": true,
      "note": "用于逐题找依据"
    }
  ],
  "methods": [
    {
      "stage": "organize",
      "how": "先把题目原样列出，保留选项、题号、题源；题干不改写、不调语序",
      "produces": "题目清单"
    },
    {
      "stage": "collect",
      "how": "逐题按题干里的小节标题词定位，不按概念词；取到能回答这道题的行",
      "produces": "每题依据"
    },
    {
      "stage": "solve",
      "how": "只回答这道题问的事；选项题保留正确选项的原文表述",
      "produces": "逐题答案"
    },
    {
      "stage": "make",
      "how": "按模板填字段；题源写进引用",
      "produces": "卡"
    }
  ],
  "output": {
    "model": "QAC 问答挖空 v4（国标引用）",
    "template": "qac-v4",
    "fields": [
      {
        "name": "问题",
        "role": "content",
        "spec": "以「？」结尾；题干照抄（可缩为问句），不改写、不调语序；保留题号信息到引用",
        "required": true
      },
      {
        "name": "章节定位",
        "role": "locator",
        "spec": "依据所在章节，`书名 ‖ 章 ‖ 节`",
        "required": true
      },
      {
        "name": "要点数",
        "role": "meta",
        "spec": "答案去标签与挖空标记后的可见字数，写 `N字`",
        "required": true
      },
      {
        "name": "答案",
        "role": "content",
        "spec": "只答这道题；整段 `{{c1:: … }}`；单行 ≤25 字；不用 <ul>/<ol>；不用 Markdown",
        "required": true
      },
      {
        "name": "笔记",
        "role": "memory",
        "spec": "这道题最易错的一点，两行以内",
        "required": false
      },
      {
        "name": "引用",
        "role": "locator",
        "spec": "以 `题源：` 开头，写题号或出处；随后书目 + `‖ p页:L起-止`",
        "required": true
      }
    ]
  },
  "presentation": {
    "forms": [
      "outline",
      "table"
    ],
    "chooseBy": "选项并列或对比关系用表格，单点用序号树"
  },
  "quality": {
    "rules": [
      {
        "id": "q-ask",
        "field": "问题",
        "kind": "endsWith",
        "value": "？"
      },
      {
        "id": "a-open",
        "field": "答案",
        "kind": "startsWith",
        "value": "{{c1::"
      },
      {
        "id": "a-close",
        "field": "答案",
        "kind": "endsWith",
        "value": "}}"
      },
      {
        "id": "a-no-list",
        "field": "答案",
        "kind": "forbids",
        "value": "<ul|<ol|\\*\\*"
      },
      {
        "id": "meta-length",
        "field": "要点数",
        "kind": "lengthOf",
        "sourceField": "答案"
      },
      {
        "id": "cite-source",
        "field": "引用",
        "kind": "startsWith",
        "value": "题源："
      },
      {
        "id": "cite-locator",
        "field": "引用",
        "kind": "matches",
        "value": "‖\\s*p\\d+:L?\\d+"
      }
    ],
    "rubric": "题面与原文问的是同一件事；选项与题源完整；依据能回查；一题两考点时拆卡但题源只跟原题走"
  },
  "acceptance": {
    "criteria": "先跑一道题，确认题源、选项与依据对得上"
  },
  "limits": [
    "题干有争议或版本不一致时必须停下问用户"
  ],
  "origin": {
    "kind": "seed",
    "note": "题源驱动示例"
  }
}
